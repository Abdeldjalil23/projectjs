# Copy this file to .env.local and fill in the values from
# Supabase > Project Settings > API Keys. Use the Publishable key (sb_publishable_...).
# Never put the Secret key (sb_secret_...) here or anywhere in the front end.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
